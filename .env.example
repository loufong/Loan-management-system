# =========================================================================
# APEX LOAN MANAGEMENT SYSTEM (LMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# Database Connection (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loansystem_db?schema=public"

# Application Server
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# Cryptography & Security
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Real Gmail SMTP Configuration (Nodemailer)
# IMPORTANT: Generate a 16-character Google App Password with 2-Step Verification enabled.
# Do NOT use your normal Google account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-real-gmail@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"
MAIL_FROM="Apex LMS <noreply@gmail.com>"

# Optional Email Service Aliases
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
EMAIL_SECURE="true"
EMAIL_USER="your-real-gmail@gmail.com"
EMAIL_PASSWORD="your-16-character-google-app-password"
EMAIL_FROM="Apex LMS <noreply@gmail.com>"
