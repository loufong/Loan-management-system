# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loansystem_db?schema=public"

# Application Server
NODE_ENV="production"
PORT=5000
FRONTEND_URL="https://loufong.github.io/Loan-management-system"
BACKEND_URL="https://your-backend-domain.com"
ALLOWED_ORIGINS="https://loufong.github.io,http://localhost:3000,http://localhost:5173"

# Cryptography & Security
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# =========================================================================
# Transactional Email Service Configuration
# =========================================================================
# Active provider: "resend" (Recommended for production) or "smtp" (for Gmail/custom SMTP)
EMAIL_PROVIDER="resend"

# OPTION 1: Resend (Recommended - Configured ONCE by System Owner, works for any user)
# Get a free API key at https://resend.com
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="Apex Loan Management System <onboarding@resend.dev>"
EMAIL_FROM_NAME="Apex Loan Management System"

# OPTION 2: Gmail SMTP / Custom SMTP (Development or alternative)
# If using Gmail, generate a 16-character Google App Password under Security > App Passwords.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE="false"
EMAIL_USER="your-system-gmail@gmail.com"
EMAIL_PASSWORD="your-16-char-google-app-password"

# Backwards-Compatible SMTP Aliases
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-system-gmail@gmail.com"
SMTP_PASSWORD="your-16-char-google-app-password"

# KYC & Loan Document Storage Configuration (LOCAL, S3, SUPABASE, CLOUDINARY)
STORAGE_DRIVER="LOCAL"
AWS_S3_BUCKET="apex-lms-documents"
AWS_S3_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_URL=""
SUPABASE_STORAGE_KEY=""
