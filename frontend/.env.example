# Production Backend API URL
# In local development, defaults to relative /api or http://localhost:5000/api/v1
# In production / GitHub Pages, set to your deployed backend URL:
VITE_API_URL="https://api.loansystem.yourdomain.com/api/v1"

# Supabase (PostgreSQL) Production Credentials
# In GitHub Actions, configure these in Repository Settings -> Secrets and Variables -> Actions
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Application Base Path (defaults to /Loan-management-system/ on GitHub Pages)
VITE_BASE_PATH="/Loan-management-system/"
